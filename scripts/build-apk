#!/usr/bin/env bash
#
# Build the Rust library for Android and assemble the APK.
#
#   scripts/build-apk             # debug APK
#   scripts/build-apk --release   # release APK, for adb; debug-signed unless
#                                 # the upload key is in the environment
#   scripts/build-apk --bundle    # the release bundle (.aab) Play takes,
#                                 # signed with the upload key -- refused
#                                 # without it (docs/play-store.md)
#
# Two steps, deliberately separate: `cargo ndk` builds libsigil_android.so
# into the Gradle project's jniLibs, then Gradle packages it. Gradle does
# not drive cargo, so this refuses to run Gradle without a fresh library.
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
profile=debug
gradle_task=assembleDebug
outputs='app/build/outputs/apk/*/*.apk'
case "${1:-}" in
    "") ;;
    --release)
        profile=release
        gradle_task=assembleRelease
        ;;
    --bundle)
        profile=release
        gradle_task=bundleRelease
        outputs='app/build/outputs/bundle/release/*.aab'
        # Play refuses a debug-signed bundle, so building one is only a
        # way to find that out later. build.gradle.kts takes the debug key
        # when the upload key is absent, for an APK that installs over adb;
        # a bundle does not get that fallback.
        for v in SIGIL_UPLOAD_KEYSTORE SIGIL_UPLOAD_KEYSTORE_PASSWORD SIGIL_UPLOAD_KEY_ALIAS SIGIL_UPLOAD_KEY_PASSWORD; do
            [ -n "${!v:-}" ] || { echo "--bundle needs the upload key: $v is not set (see docs/play-store.md)"; exit 1; }
        done
        [ -f "$SIGIL_UPLOAD_KEYSTORE" ] || { echo "SIGIL_UPLOAD_KEYSTORE=$SIGIL_UPLOAD_KEYSTORE is not a file"; exit 1; }
        ;;
    *) echo "usage: scripts/build-apk [--release|--bundle]"; exit 2 ;;
esac

: "${ANDROID_NDK_HOME:?set ANDROID_NDK_HOME to the NDK (see docs/building.md)}"
command -v cargo-ndk >/dev/null || { echo "cargo-ndk is not installed: cargo install cargo-ndk"; exit 1; }

abi="$(sed -n 's/^sigil\.abi=//p' "$repo/android/gradle.properties")"
abi="${abi:-arm64-v8a}"
# The platform level the library links against: the app's minSdk. AAudio,
# which cpal plays through, exists from 26; cargo-ndk's default of 21 has
# no libaaudio to link and fails at the very end of the build.
platform=26
out="$repo/android/app/src/main/jniLibs"

# Until sqnr's Android change is tagged: point cargo at the sibling checkout.
# sqex is already patched in Cargo.toml (SIP-52). Override with SQNR_PATH.
sqnr="${SQNR_PATH:-$repo/../sqnr}"
patch_args=(
    --config "patch.\"https://github.com/wave-cl/sqnr\".sqnr.path=\"$sqnr/crates/sqnr\""
    --config "patch.\"https://github.com/wave-cl/sqnr\".sqnr-core.path=\"$sqnr/crates/sqnr-core\""
)

echo "== cargo ndk ($abi, $profile)"
release_flag=()
[ "$profile" = release ] && release_flag=(--release)
(cd "$repo" && cargo ndk -t "$abi" -P "$platform" -o "$out" "${patch_args[@]}" build -p sigil-android "${release_flag[@]}")

lib="$out/$abi/libsigil_android.so"
[ -f "$lib" ] || { echo "no $lib was built; not running Gradle"; exit 1; }
echo "== $lib ($(du -h "$lib" | cut -f1)) before stripping"

# Strip here, with the NDK's own strip. Gradle would, given an ndkVersion it
# can find, but the first APK shipped 572 MB of debug symbols because it
# could not, and packaged the library as it was. The symbols are in
# target/ for anyone reading a crash.
strip="$(ls "$ANDROID_NDK_HOME"/toolchains/llvm/prebuilt/*/bin/llvm-strip | head -1)"
[ -x "$strip" ] || { echo "no llvm-strip in the NDK"; exit 1; }
"$strip" --strip-unneeded "$lib"
echo "== $lib ($(du -h "$lib" | cut -f1)) stripped"

# The C++ runtime the library links (openh264 is C++, and the NDK links it
# shared). Nothing packages it for us: without this copy the first launch
# dies in System.loadLibrary with "libc++_shared.so not found".
case "$abi" in
    arm64-v8a) triple=aarch64-linux-android ;;
    armeabi-v7a) triple=arm-linux-androideabi ;;
    x86_64) triple=x86_64-linux-android ;;
    x86) triple=i686-linux-android ;;
    *) echo "unknown abi $abi"; exit 1 ;;
esac
cxx="$(ls "$ANDROID_NDK_HOME"/toolchains/llvm/prebuilt/*/sysroot/usr/lib/"$triple"/libc++_shared.so | head -1)"
[ -f "$cxx" ] || { echo "no libc++_shared.so for $triple in the NDK"; exit 1; }
cp "$cxx" "$out/$abi/"
echo "== packaged $(basename "$cxx") beside it"

echo "== gradle $gradle_task"
cd "$repo/android"
if [ -x ./gradlew ]; then
    ./gradlew --no-daemon "$gradle_task"
else
    gradle --no-daemon "$gradle_task"
fi
ls -1 $outputs
